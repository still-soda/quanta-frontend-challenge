{
   "name": "@challenge/core",
   "description": "前端挑战判题机核心",
   "private": true,
   "version": "0.5.0",
   "type": "module",
   "scripts": {
      "dev": "vite",
      "build": "tsc && vite build",
      "preview": "vite preview"
   },
   "devDependencies": {
      "@types/jest": "^29.5.14",
      "@types/node": "^22.14.0",
      "jest": "^29.7.0",
      "ts-jest": "^29.2.5",
      "typescript": "~5.7.2",
      "vite": "^6.2.0"
   },
   "dependencies": {
      "@challenge/utils": "workspace:^",
      "jimp": "^1.6.0",
      "playwright": "^1.50.1",
      "zod": "^3.24.2"
   },
   "jest": {
      "moduleFileExtensions": [
         "js",
         "json",
         "ts"
      ],
      "moduleNameMapper": {
         "@challenge/utils": "<rootDir>/../../utils/index.ts"
      },
      "resolver": "jest-ts-webcompat-resolver",
      "rootDir": "src",
      "testRegex": ".*\\.spec\\.ts$",
      "transform": {
         "^.+\\.(t|j)s$": "ts-jest",
         "^.+\\.js$": "babel-jest"
      },
      "testTimeout": 20000,
      "collectCoverageFrom": [
         "**/*.(t|j)s"
      ],
      "coverageDirectory": "../coverage",
      "testEnvironment": "node"
   }
}
